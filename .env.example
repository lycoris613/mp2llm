# Spring Boot 와 FastAPI 양쪽에 동일하게 설정 (X-Internal-Token 헤더 검증용)
# 혹여나 나중에 배포할 수도 있으니 일단 채워는 두었음.
INTERNAL_SHARED_SECRET=replace-with-a-random-secret

# gemini: 실제 호출 / mock: API 키 없이 고정 응답 (프론트·Spring 연동 확인용)
LLM_PROVIDER=gemini

GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=180